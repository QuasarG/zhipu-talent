[Unit]
Description=AGI Talent Radar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=talent-radar
Group=talent-radar
WorkingDirectory=/opt/zhipu-talent/current
# 数据库连接只在生产环境文件中配置，避免 unit 内默认值覆盖或误导运维。
EnvironmentFile=/etc/zhipu-talent.env
Environment=IMPORT_CONCURRENCY=2
ExecStart=/opt/zhipu-talent/venv/bin/gunicorn --worker-class gthread --workers 1 --threads 24 --bind 127.0.0.1:8503 --timeout 900 --graceful-timeout 30 --keep-alive 5 --access-logfile - --error-logfile - agi_talent_radar.web.workbench:app
Restart=on-failure
RestartSec=5
Nice=10
CPUQuota=60%
# OCR（rapidocr-onnxruntime）首次触发时懒加载 onnxruntime+opencv，峰值多约 400M；
# 2C4G 机器 1.2G 上限安全，2C2G 机器务必加 2-4G swap
MemoryHigh=900M
MemoryMax=1200M
OOMScoreAdjust=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/zhipu-talent

[Install]
WantedBy=multi-user.target
