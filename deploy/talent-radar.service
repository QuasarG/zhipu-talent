[Unit]
Description=AGI Talent Radar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=talent-radar
Group=talent-radar
WorkingDirectory=/opt/zhipu-talent/current
EnvironmentFile=/etc/zhipu-talent.env
Environment=DATABASE_URL=sqlite:////var/lib/zhipu-talent/talent_radar.db
Environment=IMPORT_CONCURRENCY=2
ExecStart=/opt/zhipu-talent/venv/bin/gunicorn --worker-class gthread --workers 1 --threads 2 --bind 127.0.0.1:8503 --timeout 900 --graceful-timeout 30 --keep-alive 5 --access-logfile - --error-logfile - agi_talent_radar.web.workbench:app
Restart=on-failure
RestartSec=5
Nice=10
CPUQuota=60%
MemoryHigh=512M
MemoryMax=640M
OOMScoreAdjust=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/zhipu-talent

[Install]
WantedBy=multi-user.target
