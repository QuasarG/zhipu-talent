DEEPSEEK_API_KEY=your_deepseek_key_here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# 智谱视觉理解 MCP（PDF 导入必需）
Z_AI_API_KEY=
Z_AI_MODE=ZHIPU
# Z_AI_VISION_MODEL=glm-4.6v
# Z_AI_MCP_TIMEOUT_SECONDS=330
# Z_AI_MCP_NODE=C:/path/to/node.exe

# 自定义视觉 MCP 适配器会覆盖上述默认实现（可选）
# VISION_MCP_ADAPTER=your_package.your_module:vision_client

# 批量简历导入并发数，取值 1-5；低内存服务器建议 1-2
IMPORT_CONCURRENCY=5

# MySQL 数据库配置（可选；未配置时评估结果只写入文件）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=talent_radar
# 或者直接用 DATABASE_URL=mysql+pymysql://root:password@localhost:3306/talent_radar
DATABASE_URL=
