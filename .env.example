DEEPSEEK_API_KEY=your_deepseek_key_here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
OPENAI_TIMEOUT_SECONDS=120

# 智谱开放平台（Web Search + Embedding）
Z_AI_API_KEY=
Z_AI_MODE=ZHIPU

# AMiner MCP 服务（嘉宾画像研究方向，SSE 协议；留空时自动降级走 web_search）
AMINER_AUTH_TOKEN=
AMINER_MCP_URL=https://mcp.aminer.cn/sse

# AMiner REST API（论文核验主力源；留空时降级走 OpenAlex 兜底）
# 控制台生成 Token：https://open.aminer.cn/open/board?tab=control
AMINER_API_TOKEN=

# OpenAlex（免费学术图谱，带 mailto 进礼貌池）
OPENALEX_MAILTO=

# 批量简历导入并发数，取值 1-5；低内存服务器建议 1-2
IMPORT_CONCURRENCY=5

# MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=talent_radar
# 或者直接用 DATABASE_URL=mysql+pymysql://root:password@localhost:3306/talent_radar
DATABASE_URL=

# 鉴权（内部工具单密码）
APP_AUTH_PASSWORD=your_access_password
FLASK_SESSION_SECRET=your_random_secret_string

# Qdrant 向量数据库（不配则 RAG 降级为 MySQL-only）
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=talent_knowledge

# Embedding（固定智谱 embedding-3 / 1024 维）
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=1024
