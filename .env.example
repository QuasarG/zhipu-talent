# LLM（DeepSeek 或任意 OpenAI 兼容 API）
LLM_API_KEY=
OPENAI_MODEL=glm-5.2
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_TIMEOUT_SECONDS=120

# MySQL
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=talent_radar

# 智谱（Web Search + Embedding）
Z_AI_API_KEY=
Z_AI_MODE=ZHIPU

# AMiner REST API（论文核验 + 学者搜索；留空时降级走 OpenAlex 兜底）
# 控制台生成 Token：https://open.aminer.cn/open/board?tab=control
AMINER_API_TOKEN=

# OpenAlex（免费学术图谱，带 mailto 进礼貌池）
OPENALEX_MAILTO=

# 鉴权（内部工具单密码）
APP_AUTH_PASSWORD=
FLASK_SESSION_SECRET=

# Qdrant 向量数据库
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=talent_knowledge

# GitHub REST（可选；不配则匿名 60 次/时，配了 5000 次/时）
GITHUB_TOKEN=

# Embedding
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=1024

# 批量简历导入并发数，取值 1-5
IMPORT_CONCURRENCY=5
